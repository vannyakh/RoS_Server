APP_NAME=RoS Private Server
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./ros_server.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0

GAME_TICK_RATE=20
MAX_PLAYERS_PER_MATCH=100
BOT_FILL=7
QUEUE_WAIT_SECONDS=2
