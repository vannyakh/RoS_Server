APP_NAME=RoS Private Server
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./ros_server.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0

GAME_TICK_RATE=20
MAX_PLAYERS_PER_MATCH=100
BOT_FILL=7
QUEUE_WAIT_SECONDS=2

# Staff sign-in for the operations panel. Leave blank until the first operator should be created.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Operator sign-in lasts at most this long through token refreshes.
OPERATOR_SESSION_MAX_HOURS=12
# Shared key for bigworld_gateway. Leave empty to disable /api/v1/gateway.
# After editing, run: python scripts/sync_gateway_env.py  (writes bigworld_gateway/.env)
GATEWAY_API_KEY=
# Season shown on the original client Stats tab (match bigworld_gateway/config.cmd GATEWAY_CURRENT_SEASON).
GATEWAY_CURRENT_SEASON=21
# Offline IP-to-country file, e.g. DB-IP "IP to Country Lite" (.mmdb, CC BY 4.0). Needs the maxminddb package.
GEOIP_DB_PATH=
# Asset library image folder. Empty: storage/game_assets/icons (git-ignored).
GAME_ASSET_DIR=

# jev.ai assistant skill. Put the real key in .env only; never commit it.
JEV_API_KEY=
JEV_BASE_URL=
