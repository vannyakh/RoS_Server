server/certs/*.key
server/certs/*.csr
server/certs/*.srl
server/server_keys/*priv*
*.pem
# runtime
logs/
__pycache__/
*.pyc
*.bak
server/saved_accounts.json
# large binaries: attach to GitHub Releases instead
client/apk/*.apk
# local settings / secrets
.env
