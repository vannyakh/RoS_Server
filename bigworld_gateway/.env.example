# Copy to .env (never commit .env). ros_server.py reads it through server/account_link.py.

# --- link to RoS_Server (FastAPI) accounts + admin console ---
# RoS_Server API base URL
ROS_API_URL=http://127.0.0.1:8000
# Must equal GATEWAY_API_KEY in RoS_Server/.env. Empty = no link, local saved_accounts.json is used.
GATEWAY_API_KEY=
# Seconds to wait for the API before falling back to local accounts
ROS_API_TIMEOUT=2

# --- admin console account (used by RoS_Server, not by the gateway) ---
# RoS_Server creates this operator on startup. Set the same values in RoS_Server/.env.
ADMIN_USERNAME=
ADMIN_PASSWORD=
