# Prefer: python scripts/sync_gateway_env.py  (copies from RoS_Server/.env).
# account_link also reads RoS_Server/.env when this file is missing.

# --- link to RoS_Server (FastAPI) ---
ROS_API_URL=http://127.0.0.1:8000
# Must equal GATEWAY_API_KEY in RoS_Server/.env. Empty = no link, local saved_accounts.json only.
GATEWAY_API_KEY=
ROS_API_TIMEOUT=2

# Operator sign-in: ADMIN_USERNAME / ADMIN_PASSWORD in RoS_Server/.env only (not used by the gateway process).
