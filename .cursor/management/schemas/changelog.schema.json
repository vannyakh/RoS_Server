{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changelog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "entries"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "date",
        "version",
        "category",
        "title",
        "description",
        "task_id",
        "agent",
        "files_changed",
        "migration_revision",
        "tests",
        "breaking_change",
        "related_discovery",
        "git_commit"
      ],
      "properties": {
        "change_id": {"type": "string", "pattern": "^CH-[0-9]{4}$"},
        "date": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "category": {
          "enum": ["Added", "Changed", "Fixed", "Removed", "Security", "Database", "Gameplay", "Networking", "Compatibility", "Performance", "Infrastructure", "Documentation"]
        },
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "task_id": {"type": ["string", "null"]},
        "agent": {"type": "string", "minLength": 1},
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "migration_revision": {"type": ["string", "null"]},
        "tests": {"type": "array", "items": {"type": "string"}},
        "breaking_change": {"type": "boolean"},
        "related_discovery": {"type": ["string", "null"]},
        "git_commit": {"type": ["string", "null"]}
      }
    }
  }
}
